# The platform's GitHub App (ADR 0010), for `pnpm dev` and production. `pnpm dev:mock` needs none of it.
# Copy to .env. The app's callback URL is <platform address>/sign-in/callback.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app's name in its address: https://github.com/apps/<slug>
GITHUB_APP_SLUG=

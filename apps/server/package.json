{
  "name": "@claree/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@claree/domain": "workspace:*",
    "@claree/github-adapters": "workspace:*",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@claree/mock-adapters": "workspace:*",
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}

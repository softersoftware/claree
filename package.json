{
  "name": "claree",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @claree/server --filter @claree/web dev",
    "dev:mock": "pnpm --filter @claree/web dev:mock",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
